{
  "name": "mdctx",
  "version": "0.1.0",
  "description": "Zero-ML-dependency keyword index for markdown context files. Fast, git-diffable context retrieval for LLM workspaces — usable as a CLI or an MCP server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mdctx": "dist/cli.js",
    "mdctx-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "llm",
    "context",
    "keyword-search",
    "bm25",
    "claude",
    "markdown",
    "rag"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/mdctx.git"
  },
  "homepage": "https://github.com/YOUR_USERNAME/mdctx",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/mdctx/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
